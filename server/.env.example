# CODED FIT Backend Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/coded_fit

# JWT Authentication
JWT_SECRET=coded_fit_jwt_secure_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Live/Test Credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Perfect Corp YouCam AI Virtual Try-On (Rotate credentials if previously exposed)
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com/wow/api/v1

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
