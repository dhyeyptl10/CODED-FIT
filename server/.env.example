# ══════════════════════════════════════════════════════════════
# CODED FIT Backend — REAL API keys guide
# Copy: cp .env.example .env   (never commit .env — it is gitignored)
# Validate: npm run check-env
# RULE: secrets live ONLY here. Never in HTML/JS/TSX, APK, or git.
# ══════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=5000

# MongoDB — local: mongodb://127.0.0.1:27017/coded_fit
# Production: Atlas connection string from https://cloud.mongodb.com
MONGODB_URI=mongodb://127.0.0.1:27017/coded_fit

# JWT — generate a fresh one, min 32 chars:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_EXPIRES_IN=7d

# Razorpay — dashboard.razorpay.com → Settings → API Keys
# Test mode keys start rzp_test_ | Live keys start rzp_live_
# NEVER ship test keys to production, never expose KEY_SECRET in frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Perfect Corp YouCam AI Virtual Try-On — developer.perfectcorp.com
# Used ONLY by server/services/youcamService.js via POST /api/try-on.
# If these were ever pasted into frontend/mobile/git: ROTATE them in the portal first.
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com/wow/api/v1

# Ollama (local AI, optional) — https://ollama.com  →  ollama pull qwen3:8b
# Without Ollama the assistant uses built-in honest fallbacks (no fake AI claims).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:8b

# CORS — production: your exact web domain (no wildcard with credentials)
CLIENT_URL=http://localhost:5000
