# CODED FIT mobile app — backend connection
# ── Web (expo start --web) ya emulator: localhost chalta hai
# EXPO_PUBLIC_API_BASE=http://localhost:5000/api
#
# ── Physical device (Expo Go, same Wi-Fi): apne computer ka LAN IP likho,
#     e.g. EXPO_PUBLIC_API_BASE=http://192.168.1.5:5000/api
#     (Windows: ipconfig → IPv4 Address. Phone + PC same Wi-Fi par hona chahiye.)
# ── Bina backend ke app catalog/cart offline chalenge; AI chat + real
#     try-on ke liye backend chahiye: cd server && npm start
EXPO_PUBLIC_API_BASE=http://localhost:5000/api

# App Environment
EXPO_PUBLIC_APP_NAME=CODED-FIT
EXPO_PUBLIC_APP_ENV=development
